+# ─────────────────────────── ligação com a pré-matrícula (por CGM) ───────────────────────────
+
+CAMPO_PRE_MATRICULA = "id_matricula"          # gravado no cadastro/item da pré-matrícula
+CAMPO_ORIGEM = "pre_matricula"                # gravado no período da ponte: {"arquivo", "ligado_em"} (sem CPF)
