# ==== Ambiente Python ====
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# ==== Python e navegadores locais (instalados pelo INSTALAR_WINDOWS) ====
runtime/

# ==== Credenciais e segredos (NUNCA versionar) ====
credenciais/credenciais.py
credenciais/*.env
# Perfil do navegador do WhatsApp (contém a SESSÃO logada: equivale a senha)
credenciais/whatsapp_sessao/
.env
*.key
qrcode_key.key

# ==== Dados de alunos/servidores (dados sensíveis / LGPD) ====
dados/**/*.json
# Pasta de digitalização (documentos dos alunos), em dados/ ou dados/<ano>/
dados/**/DIGITALIZAÇÃO/
dados/backup/*
!dados/backup/.gitkeep
*.csv
*.xlsx
!config/*.xlsx

# ==== Logs e locks (gerados em runtime) ====
logs/*.log
logs/*.txt
!logs/.gitkeep
locks/*.lock
locks/*.pid
!locks/.gitkeep

# ==== VS Code (mantemos apenas os arquivos de configuração do projeto) ====
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# ==== Diversos ====
.DS_Store
Thumbs.db
*.bak

# Cópias dos originais guardadas antes da compressão (podem ser GB)
dados/**/ORIGINAIS_ANTES_DA_COMPRESSAO/
