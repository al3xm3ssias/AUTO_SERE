
# ============================================================
# AUTO_SERE - .gitignore
# Proteção de dados escolares, credenciais e arquivos locais
# ============================================================

# ==== Python ====
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/

# ==== Ambientes virtuais ====
.venv/
venv/
env/
ENV/
.python-version

# ==== Python e navegadores instalados localmente ====
/runtime/

# ==== Credenciais, segredos e variáveis de ambiente ====
/credenciais/*
!/credenciais/README.md
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.secret
secrets/
credentials.json
token.json
client_secret*.json

# ==== Dados escolares e documentos pessoais ====
# Não versionar dados reais de alunos ou servidores.
/dados/

# Pastas de dados eventualmente existentes fora de /dados
**/DIGITALIZAÇÃO/
**/DIGITALIZACAO/
**/ORIGINAIS_ANTES_DA_COMPRESSAO/
**/PARECERES/
**/screenshots/

# Arquivos de dados e exportações
*.csv
*.xls
*.xlsx
*.xlsm
*.ods
*.doc
*.docx
*.odt
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.webp
*.heic

# Bancos de dados locais
*.db
*.sqlite
*.sqlite3
*.mdb

# ==== Backups e arquivos temporários ====
*.bak
*.backup
*.old
*.orig
*.tmp
*.temp
*.swp
*.swo
*~

# ==== Logs e arquivos de execução ====
*.log
*.pid
*.lock

/logs/*
!/logs/.gitkeep

/locks/*
!/locks/.gitkeep

# ==== Arquivos de backup locais ====
/backup/
/backups/
/BACKUP/
/BACKUPS/

# Arquivos compactados gerados localmente
*.zip
*.7z
*.rar
*.tar
*.gz

# ==== VS Code ====
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# ==== Outros editores e sistemas operacionais ====
.idea/
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ==== Arquivos de configuração local ====
*.local
config.local.*
