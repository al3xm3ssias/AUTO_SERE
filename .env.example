# =============================================================================
# .env.example — modelo de variáveis de ambiente do projeto AUTO_SERE
# Copie este arquivo para "credenciais/.env" (ou para a raiz, como ".env")
# e preencha com os valores reais. O arquivo real NUNCA deve ser versionado.
# =============================================================================

# Credenciais de acesso ao portal SERE
SERE_LOGIN=cpf_do_usuario
SERE_SENHA=senha_do_usuario

# Credenciais do portal da PRÉ-MATRÍCULA (usadas pela automação "Processo de pré-matrícula").
# Sem elas a automação para com uma mensagem clara, em vez de tentar logar com dados falsos.
PREMATRICULA_LOGIN=
PREMATRICULA_SENHA=

# Credenciais do RCO (Registro de Classe Digital). Deixe EM BRANCO para usar o mesmo login e senha do SERE
# (é a mesma Central de Segurança). A tela Configurações → Senha do RCO também grava estas variáveis.
RCO_LOGIN=
RCO_SENHA=

# Caminho base de trabalho (equivalente ao WORKDIR usado nos scripts .sh)
# Windows:  C:\Users\voce\AUTO_SERE_PORTABLE
# Linux:    /home/sambauser/compartilhado/ARQUIVOS/ESCOLA JUDITH/PYTHON/SERE/2026
AUTO_SERE_WORKDIR=

# Ano letivo base usado pelos scripts (ex.: 2026)
AUTO_SERE_ANO_BASE=2026

# Nível de log (DEBUG, INFO, WARNING, ERROR)
AUTO_SERE_LOG_LEVEL=INFO

# --- WhatsApp (serviço em src/servicos/whatsapp; guia em docs/WHATSAPP.md) ----------
# Provedores: simulado (padrão, nada sai do computador) | whatsplay (WhatsApp Web no navegador, SEM Docker)
# | blake (gateway Docker) | http (formato wwebjs-api, legado).
# A tela "WhatsApp" também grava estas variáveis; não precisa editar o arquivo à mão.
WHATSAPP_PROVEDOR=simulado
# whatsplay: 1 esconde a janela do navegador (padrão 0: janela visível; recomendado, pois o login é mais confiável)
WHATSAPP_WHATSPLAY_HEADLESS=0
# whatsplay: pasta do perfil com a sessão (padrão credenciais/whatsapp_sessao)
WHATSAPP_WHATSPLAY_PERFIL=
# blake: endereço do gateway (padrão http://127.0.0.1:8085). O gateway não tem senha: mantenha local.
WHATSAPP_API_URL=
# blake: 1 (padrão) consulta se o número tem WhatsApp antes de enviar
WHATSAPP_VALIDAR_NUMERO=1
# blake: número só para confirmar a conexão (padrão: um número inexistente); opcional
WHATSAPP_NUMERO_SONDA=
# blake: segredo do webhook de mensagens recebidas (gerado pela tela; não compartilhe)
WHATSAPP_WEBHOOK_TOKEN=
# blake: base da URL que o contêiner usa para chamar o sistema (padrão http://host.docker.internal:<porta>)
WHATSAPP_WEBHOOK_URL_BASE=
# http (legado): chave e sessão do gateway wwebjs-api
WHATSAPP_API_KEY=
WHATSAPP_SESSAO=autosere
# Trava de envio real: só "1" permite enviar mensagens de verdade
WHATSAPP_ENVIO_REAL=0

# --- Backup ----------------------------------------------------------------------
# Quantos backups manter em dados/backup (padrão 10).
AUTO_SERE_BACKUP_MANTER=10
