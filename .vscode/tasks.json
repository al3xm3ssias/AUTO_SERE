{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Bootstrap: criar_projeto.py",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["criar_projeto.py"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Instalar dependências",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pip", "install", "-r", "requirements.txt"],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Rodar testes (pytest)",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pytest", "tests/", "-v"],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Compileall (verificação de sintaxe)",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "compileall", "src/"],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
