+def _pedagoga_permite(metodo: str, caminho: str) -> bool:
+    metodo = "GET" if metodo in ("HEAD", "OPTIONS") else metodo
+    return any(metodo in metodos and expressao.match(caminho) for metodos, expressao in _REGRAS_PEDAGOGA)
